<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Lets the user send a spreadsheet to SEZ Print (Google Sheets: Share & export > Send a copy,
      or any file manager). The alias forwards the intent to the app's MainActivity.
    -->
    <activity-alias
      android:name="expo.modules.sharetarget.ShareTargetAlias"
      android:targetActivity="com.sezprint.app.MainActivity"
      android:exported="true"
      android:label="SEZ Print">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        <data android:mimeType="application/vnd.ms-excel" />
        <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
        <data android:mimeType="text/csv" />
        <data android:mimeType="text/comma-separated-values" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
