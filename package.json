  "scripts": {
    "postinstall": "patch-package && node ./scripts/verify-patches.mjs && node ./scripts/generate-twemoji-assets.mjs",
    "start": "node ./scripts/dev-start.js",
    "start:usb": "node ./scripts/dev-start.js --usb",
    "start:clear": "node ./scripts/dev-start.js --clear",
    "dev:all": "node ./scripts/dev-all.js",
    "connect:usb": "node ./scripts/keep-adb-reverse.js --once --open",
    "reset-project": "node ./scripts/reset-project.js",
    "verify-patches": "node ./scripts/verify-patches.mjs",
    "scan:secrets": "node ./scripts/secret-scan.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "preandroid": "node ./scripts/verify-patches.mjs && node ./scripts/keep-adb-reverse.js --once",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:home-tools": "npx --yes tsx --tsconfig tsconfig.json --test src/components/home/__tests__/home-tools.test.ts src/components/home/__tests__/home-status-colors.test.ts",
    "test:theme": "npx --yes tsx --tsconfig tsconfig.json --test src/theme/__tests__/contrast.test.ts src/theme/__tests__/no-hardcoded-colors.test.ts src/theme/__tests__/print-safe.test.ts src/lib/debug/__tests__/capture-hash.test.ts",
    "test:printer-core": "npx --yes tsx --tsconfig tsconfig.json src/printer-core/__tests__/router.test.ts",
    "test:ocr": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/ocr/__tests__/map-result.test.ts src/lib/ocr/__tests__/preprocess.test.ts src/lib/ocr/__tests__/copy-text.test.ts src/lib/ocr/__tests__/service.test.ts",
    "test:shop": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/shop/__tests__/catalog-import.test.ts src/lib/shop/__tests__/parse-product.test.ts src/lib/shop/__tests__/filter-catalog.test.ts src/lib/shop/__tests__/amazon-url.test.ts",
    "shop:catalog": "node scripts/shop/generate-catalog.mjs",
    "test:smart-crop": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/pdf-editor/smart-crop/__tests__/detector.test.ts src/lib/pdf-editor/smart-crop/__tests__/rules.test.ts src/lib/pdf-editor/smart-crop/__tests__/real-fixtures.test.ts src/lib/pdf-editor/smart-crop/__tests__/select.test.ts",
    "test:pdf-editor": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/pdf-editor/__tests__/session.test.ts",
    "test:serial": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/serial/__tests__/*.test.ts src/lib/__tests__/serial-label-document.test.ts",
    "test:label-share": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/label-share/__tests__/*.test.ts",
    "test:across": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/__tests__/across.test.ts",
    "test:saved-setup": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/__tests__/saved-setup.test.ts",
    "test:new-label": "npx --yes tsx --tsconfig tsconfig.json --test src/lib/__tests__/new-label-form.test.ts",
    "test:layout": "npx --yes tsx --tsconfig tsconfig.json --test src/theme/__tests__/layout-risks.test.ts src/theme/__tests__/font-scale.test.ts src/lib/layout/__tests__/screen-sizes.test.ts src/lib/layout/__tests__/modal-orientations.test.ts src/lib/layout/__tests__/home-header-fit.test.ts",
    "layout:matrix": "node ./scripts/layout-matrix.js",
    "layout:report": "npx --yes tsx --tsconfig tsconfig.json scripts/layout-risks.ts",
    "layout:baseline": "npx --yes tsx --tsconfig tsconfig.json scripts/layout-risks.ts --update",
    "print:calibration": "npx --yes tsx --tsconfig tsconfig.json scripts/print-calibration-box.ts",
    "print:phase1": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase1-demo.ts",
    "print:phase2": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase2-demo.ts",
    "print:phase3": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase3-demo.ts",
    "print:phase4": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase4-demo.ts",
    "test:phase4-stage-a": "npx --yes tsx --tsconfig tsconfig.json src/printing/raster/__tests__/stage-a-gates.ts",
    "test:phase4-parity": "npx --yes tsx --tsconfig tsconfig.json src/printing/raster/__tests__/parity-diff-run.ts",
    "gate-a:device": "bash ./scripts/run-gate-a-device.sh",
    "dot-buffer-1k:device": "bash ./scripts/run-dot-buffer-1k-device.sh",
    "print:phase5": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase5-demo.ts",
    "print:phase6": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase6-demo.ts",
    "print:phase7": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase7-demo.ts",
    "print:phase8": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase8-demo.ts",
    "print:phase9": "npx --yes tsx --tsconfig tsconfig.json scripts/print-phase9-demo.ts",
    "prebuild:android": "npm run -s test:layout",
    "build:android": "node ./scripts/eas-build.js android preview",
    "prebuild:android:dev": "npm run -s test:layout",
    "build:android:dev": "node ./scripts/eas-build.js android development"
