  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition",
          "td404-rudra-printer",
          "td404-tejas-printer",
          "josh-printer",
          "dev-printer",
          "pdf-raster"
        ],
        "listUnknownPackages": false
      }
    },
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/ui",
          "expo-glass-effect",
          "expo-speech-recognition"
        ],
        "buildFromSource": [
          "expo-document-picker"
        ]
      }
    }
  },
  "private": true
