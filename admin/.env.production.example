ADMIN_FIXED_USERNAME=
ADMIN_FIXED_PASSWORD=
DATABASE_URL=
DIRECT_URL=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_PE_ID=
OTP_LENGTH=
OTP_EXPIRY_MINUTES=
