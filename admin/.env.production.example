# Production variables for api2.seznik.in. Names only; real values live in /etc/sez-print/admin.env on the droplet.
# `node scripts/env-check.mjs` compares the live environment with this list.
NODE_ENV=production
ADMIN_SESSION_SECRET=
APP_TOKEN_SECRET=
OTP_HASH_SECRET=
