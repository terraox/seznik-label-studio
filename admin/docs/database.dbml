// SEZ Print database diagram (DBML). Paste into https://dbdiagram.io to see it.
// Docs: https://dbml.dbdiagram.io/docs
//
// Source of truth: admin/prisma/schema.prisma. After changing it, update this file and run
//   npm run check:dbml     (fails when a table or column is missing here)
//
// Legend
//   [BUILT]  table exists in Postgres and is used by code today
//   [READY]  table exists in Postgres, filled by a later phase (print events, feedback, catalogue...)
//   [FILE]   not in Postgres: lives in admin/data/store.json until it moves in a later step
//            (today only the demo desk content: templates, clipart, reviews, suggestions)

Project sez_print {
  database_type: 'PostgreSQL'
  Note: 'SEZ Print mobile app accounts, printing analytics, feedback, shop clicks, clipart/template catalogue.'
}

Enum UserStatus {
  active
  blocked
}

Enum StatusAction {
  block
  unblock
  force_logout
}

// ─────────────── Accounts and blocking [BUILT] ───────────────

Table AppUser {
  id varchar [pk, note: 'cuid']
  name varchar [not null]
  mobile varchar [unique, not null, note: 'Normalised 10-digit Indian number (6-9 first digit)']
  passwordHash varchar [not null, note: 'bcrypt. Never returned by any API']
  printerName varchar [note: 'Printer the user says they bought: tejas | rudra | josh']
  status UserStatus [not null, default: 'active']
  blockedAt timestamp
  blockedBy varchar [note: 'Admin who blocked']
  blockMessage varchar [note: 'Shown to the user on the blocked screen']
  blockInternalNote varchar [note: 'Admins only']
  tokenVersion int [not null, default: 0, note: 'Bumped on block / sign-out; app tokens must carry the current value']
  printCountTotal int [not null, default: 0, note: 'Labels sent to a connected printer']
  lastPrintAt timestamp
  lastSeenAt timestamp
  appVersion varchar
  platform varchar
  deviceModel varchar
  isInternal boolean [not null, default: false, note: 'Test / staff account']
  passwordUpdatedAt timestamp
  deletedAt timestamp
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  lastLoginAt timestamp

  indexes {
    printerName
    status
    createdAt
  }
  Note: '[BUILT] One row per registered mobile app user.'
}

Table RegisteredPhone {
  mobile varchar [pk, note: 'Same normalised number as AppUser.mobile']
  userId varchar [unique, note: 'Null for a number an admin pre-blocked']
  firstRegisteredAt timestamp [not null]
  blocked boolean [not null, default: false]
  blockReason varchar
  blockedAt timestamp

  indexes {
    blocked
  }
  Note: '[BUILT] Permanent claim on a number. Rows are never deleted, so a number can sign up once only.'
}

Table UserStatusEvent {
  id varchar [pk]
  userId varchar [not null]
  action StatusAction [not null]
  message varchar [note: 'User-visible text (block) or the unblock note']
  internalNote varchar
  adminEmail varchar [not null]
  createdAt timestamp [not null]

  indexes {
    (userId, createdAt)
  }
  Note: '[BUILT] Every block, unblock and forced sign-out.'
}

// ─────────────── Printing [READY] ───────────────

Table Printer {
  id varchar [pk]
  nameRaw varchar [unique, not null, note: 'Exactly as the SDK reports it']
  modelNormalised varchar [not null]
  sdkFamily varchar [not null, default: 'unknown', note: 'dev | tez | josh | labelx | td404 | unknown']
  firstSeenAt timestamp [not null]

  indexes {
    modelNormalised
  }
  Note: '[READY] Distinct printer names seen.'
}

Table UserPrinter {
  id varchar [pk]
  userId varchar [not null]
  printerId varchar [not null]
  firstConnectedAt timestamp [not null]
  lastConnectedAt timestamp [not null]
  connectionCount int [not null, note: 'Distinct connections (reconnects within 10 minutes count once)']
  labelsPrinted int [not null, note: 'Labels sent to this printer']
  lastTransport varchar [note: 'bt_spp | ble | wifi']

  indexes {
    (userId, printerId) [unique]
    (userId, lastConnectedAt)
  }
  Note: '[READY] Per user and printer summary, updated with each event; the user card reads this instead of grouping history.'
}

Table TemplateCategory {
  id varchar [pk]
  name varchar [unique, not null]
  sortOrder int [not null]
  createdAt timestamp [not null]
  Note: '[READY] Categories for label templates.'
}

Table Template {
  id varchar [pk]
  categoryId varchar [not null]
  name varchar [not null]
  svgCode text [not null, note: 'The sanitised SVG code']
  widthMm float [not null]
  heightMm float [not null]
  viewBox varchar
  sampleLayout jsonb [note: 'Sample elements (text, barcode, qrcode, line) in mm; null when none']
  contentHash varchar [not null]
  status varchar [not null, note: 'draft | published']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  Note: '[READY] Label templates uploaded as SVG; the code is stored in the row.'
}

Table ClipartCategory {
  id varchar [pk]
  name varchar [unique, not null]
  sortOrder int [not null]
  createdAt timestamp [not null]
  Note: '[READY] Categories for admin-added clipart.'
}

Table Clipart {
  id varchar [pk]
  categoryId varchar [not null]
  name varchar [not null]
  svgCode text [not null, note: 'The sanitised SVG code']
  widthMm float
  heightMm float
  viewBox varchar
  contentHash varchar [not null]
  status varchar [not null, note: 'draft | published']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]
  Note: '[READY] Clipart added by the admin, on top of the clipart bundled in the app.'
}

Ref: Template.categoryId > TemplateCategory.id
Ref: Clipart.categoryId > ClipartCategory.id

Table PrinterConnection {
  id varchar [pk]
  eventId varchar [unique, not null, note: 'Client uuid: makes retries safe']
  userId varchar [not null]
  printerId varchar [not null]
  transport varchar [not null, note: 'bt_spp | ble | wifi']
  occurredAt timestamp [not null]
  receivedAt timestamp [not null]

  indexes {
    (userId, occurredAt)
    printerId
  }
  Note: '[READY] One successful connect (not retries or flaps).'
}

Table PrintEvent {
  id varchar [pk]
  eventId varchar [unique, not null]
  jobId varchar [not null]
  userId varchar [note: 'Null once the account is deleted (events are kept)']
  printerId varchar [not null, note: 'Mandatory: no printer, no count']
  source varchar [not null, note: 'manual_size | template | excel_bulk | pdf | photo | scan | serial | other']
  labelWidthMm float [not null]
  labelHeightMm float [not null]
  templateId varchar
  templateNameSnapshot varchar
  labelKey varchar [not null, note: 'manual:{W}x{H} or template:{id}:{W}x{H}']
  jobs int [not null, default: 1]
  labelsCount int [not null, note: 'Physical labels confirmed sent (headline number)']
  ups int [not null, default: 1]
  appVersion varchar
  occurredAt timestamp [not null]
  receivedAt timestamp [not null]

  indexes {
    occurredAt
    (userId, occurredAt)
    labelKey
    printerId
  }
  Note: '[READY] One finished print job.'
}

// ─────────────── Feedback and shop [READY] ───────────────

Table Feedback {
  id varchar [pk]
  eventId varchar [unique, not null]
  userId varchar [not null]
  rating int [not null, note: '1 to 5']
  category varchar [not null, note: 'suggestion | bug | other']
  message varchar
  appVersion varchar
  platform varchar
  status varchar [not null, default: 'new', note: 'new | reviewed | resolved']
  adminNote varchar
  createdAt timestamp [not null]

  indexes {
    rating
    (status, createdAt)
  }
  Note: '[READY] Star ratings and suggestions from the app.'
}

Table ProductClick {
  id varchar [pk]
  eventId varchar [unique, not null]
  userId varchar [not null]
  productKey varchar [not null, note: 'Product id from the app shop catalogue']
  productNameSnapshot varchar [not null]
  category varchar [not null, note: 'labels | printers']
  source varchar [not null, default: 'shop_buy']
  occurredAt timestamp [not null]

  indexes {
    (productKey, occurredAt)
  }
  Note: '[READY] A tap on a shop product.'
}

// ─────────────── Clipart and template library [READY] ───────────────

// ─────────────── Platform ───────────────

Table OtpCode {
  id varchar [pk]
  mobile varchar [not null]
  purpose varchar [not null, note: 'register | login']
  codeHash varchar [not null, note: 'HMAC of the code, never the code']
  attempts int [not null, default: 0]
  expiresAt timestamp [not null]
  consumedAt timestamp
  createdAt timestamp [not null]

  indexes {
    (mobile, createdAt)
  }
  Note: '[BUILT] SMS one-time codes (replaces the old in-memory store).'
}

Table RateLimit {
  key varchar [pk, note: 'e.g. otp-cooldown:98xxxxxx10, login:98xxxxxx10']
  count int [not null]
  windowStart timestamp [not null]
  updatedAt timestamp [not null]
  Note: '[BUILT] Fixed-window counters shared by every server.'
}

Table AppConfig {
  key varchar [pk, note: 'adminContact | minAppBuild | legacyCutoff']
  value json [not null]
  updatedAt timestamp [not null]
  Note: '[BUILT] Settings the app reads from GET /api/app/config.'
}

// ─────────────── Not in Postgres yet [FILE] ───────────────

// ─────────────── Relationships ───────────────

Ref: RegisteredPhone.userId - AppUser.id // one number <-> at most one account
Ref: UserStatusEvent.userId > AppUser.id
Ref: UserPrinter.userId > AppUser.id
Ref: UserPrinter.printerId > Printer.id
Ref: PrinterConnection.userId > AppUser.id
Ref: PrinterConnection.printerId > Printer.id
Ref: PrintEvent.userId > AppUser.id
Ref: PrintEvent.printerId > Printer.id
Ref: Feedback.userId > AppUser.id
Ref: ProductClick.userId > AppUser.id

