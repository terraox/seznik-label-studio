{
  "name": "sez-print-admin",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "secrets:gen": "node scripts/gen-secrets.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "check:dbml": "node scripts/check-dbml.mjs",
    "ci": "sh scripts/ci-local.sh",
    "reconcile": "npx --yes tsx scripts/reconcile-counters.mts",
    "test:catalog": "npx --yes tsx scripts/test-catalog-flow.mts",
    "test:analytics": "npx --yes tsx scripts/test-analytics-flow.mts",
    "test:events": "npx --yes tsx scripts/test-events-flow.mts",
    "test:users": "npx --yes tsx scripts/test-users-flow.mts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@prisma/client": "^6.16.2",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.2",
    "echarts": "^6.1.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.544.0",
    "motion": "^14.3.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "swagger-ui-react": "^5.29.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/swagger-ui-react": "^5.18.0",
    "prisma": "^6.16.2",
    "typescript": "^5.8.3"
  }
}
