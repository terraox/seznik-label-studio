# Required before this desk is reachable on the internet.
SEZ_ADMIN_SECRET=replace-with-a-long-random-string

# PostgreSQL for mobile app users (register / login / purchased printer)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sez_print?schema=public

# Used to sign mobile app session tokens
ADMIN_SESSION_SECRET=change-me-in-production

# MSG91 OTP (server-side only)
MSG91_AUTH_KEY=replace-with-msg91-authkey
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SEZNIK
MSG91_PE_ID=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
