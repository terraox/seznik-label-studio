# Copy to .env and fill in. Never commit .env.

# --- Server secrets: each 32+ chars, all four different. Generate with: npm run secrets:gen
# The server refuses to start if any is missing, short, a placeholder, or reused.
ADMIN_SESSION_SECRET=
APP_TOKEN_SECRET=
OTP_HASH_SECRET=
SEZ_ADMIN_SECRET=

# --- The one admin who signs in to the desk. Set both; the server will not start without them.
# Change the password by editing it here and restarting.
ADMIN_FIXED_USERNAME=
ADMIN_FIXED_PASSWORD=

# --- Optional: second admin API sign-in (/api/admin/*). Off unless both are set.
# ADMIN_PASSWORD must be 16+ characters.
ADMIN_USER_ID=
ADMIN_PASSWORD=

# PostgreSQL for mobile app users (register / login / purchased printer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Same DB without the pooler host (used by prisma db push / migrate)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# MSG91 OTP (server-side only; never ship the auth key in the app)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SEZNIK
MSG91_PE_ID=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# --- Catalogue files (clipart / template SVGs). Default: local disk, served by this server.
# STORAGE_DRIVER=local | s3   (s3 is only used when deployed)
STORAGE_DRIVER=local
# PUBLIC_BASE_URL=http://localhost:3000     # address the app uses to fetch local files
# S3_BUCKET=  S3_REGION=ap-south-1  S3_ENDPOINT=  S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=   # or use the server role
# CDN_BASE_URL=https://xxxx.cloudfront.net    # public address of the S3 files

# Developer bypass (optional, leave unset in production): mobile:code pairs, code = OTP_LENGTH digits. No SMS is sent for these numbers.
# OTP_DEV_BYPASS=9876543210:123456
