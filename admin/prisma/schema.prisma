// Source of truth for the Postgres tables. Keep database.dbml in step:
//   npm run check:dbml   fails when a model or column is missing from the diagram.
// Change flow:  edit this file -> npm run db:migrate -- --name <what_changed> -> update the .dbml.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  blocked
}

enum StatusAction {
  block
  unblock
  force_logout
}

// ───────────────────────── Mobile app accounts ─────────────────────────

/// Mobile app account. Password is stored hashed (bcrypt). `mobile` is the normalised 10-digit number.
model User {
  id                String     @id @default(cuid())
  name              String
  mobile            String     @unique
  passwordHash      String
  /// Purchased printer: tejas | rudra | josh
  printerName       String?
  status            UserStatus @default(active)
  blockedAt         DateTime?
  /// Admin sign-in (email/username) that blocked the account.
  blockedBy         String?
  /// Shown to the user on the blocked screen.
  blockMessage      String?
  /// Visible to admins only.
  blockInternalNote String?
  /// Bumped on block / force-logout; app tokens carry the value they were issued with.
  tokenVersion      Int        @default(0)
  /// Labels sent to a connected printer (kept equal to SUM(PrintEvent.labelsCount)).
  printCountTotal   Int        @default(0)
  lastPrintAt       DateTime?
  lastSeenAt        DateTime?
  appVersion        String?
  platform          String?
  deviceModel       String?
  /// Test / staff accounts; hidden from headline numbers by a toggle.
  isInternal        Boolean    @default(false)
  passwordUpdatedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?

  statusEvents     UserStatusEvent[]
  registeredAs     RegisteredPhone?
  printEvents      PrintEvent[]
  connections      PrinterConnection[]
  printers         UserPrinter[]
  feedback         Feedback[]
  templateRequests TemplateRequest[]
  productClicks    ProductClick[]

  @@index([printerName])
  @@index([status])
  @@index([createdAt])
  @@map("AppUser")
}

/// Permanent claim on a mobile number. Rows are never deleted, so a number can register once,
/// even after the account is removed. An admin can also pre-block a number with no account.
model RegisteredPhone {
  mobile            String    @id
  userId            String?   @unique
  firstRegisteredAt DateTime  @default(now())
  blocked           Boolean   @default(false)
  blockReason       String?
  blockedAt         DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([blocked])
}

/// Every block, unblock and forced logout, newest last.
model UserStatusEvent {
  id           String       @id @default(cuid())
  userId       String
  action       StatusAction
  /// User-visible text (block) or the unblock note.
  message      String?
  internalNote String?
  adminEmail   String
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Printers and printing ─────────────────────────

model Printer {
  id              String   @id @default(cuid())
  /// Name exactly as the SDK reports it.
  nameRaw         String   @unique
  modelNormalised String
  /// dev | tez | josh | labelx | td404 | unknown
  sdkFamily       String   @default("unknown")
  firstSeenAt     DateTime @default(now())

  connections PrinterConnection[]
  printEvents PrintEvent[]
  users       UserPrinter[]

  @@index([modelNormalised])
}

/// One successful connect (not retries or reconnect flaps).
model PrinterConnection {
  id         String   @id @default(cuid())
  /// Client-generated id; makes retries safe.
  eventId    String   @unique
  userId     String
  printerId  String
  /// bt_spp | ble | wifi
  transport  String
  occurredAt DateTime
  receivedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  printer Printer @relation(fields: [printerId], references: [id])

  @@index([userId, occurredAt])
  @@index([printerId])
}

/// Per user and printer: one row summarising everything that user did with that printer.
/// Kept up to date by the event handler in the same transaction as each event, so the user card
/// reads a handful of rows instead of grouping the full connection and print history.
model UserPrinter {
  id               String   @id @default(cuid())
  userId           String
  printerId        String
  firstConnectedAt DateTime
  lastConnectedAt  DateTime
  /// Distinct connections (reconnects within 10 minutes count once).
  connectionCount  Int      @default(0)
  /// Labels sent to this printer (kept equal to SUM(PrintEvent.labelsCount) for the pair).
  labelsPrinted    Int      @default(0)
  /// bt_spp | ble | wifi; the last transport seen on a connection event.
  lastTransport    String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  printer Printer @relation(fields: [printerId], references: [id])

  @@unique([userId, printerId])
  @@index([userId, lastConnectedAt(sort: Desc)])
}

/// One finished print job. A printer is mandatory: nothing is counted without a connected printer.
model PrintEvent {
  id                   String   @id @default(cuid())
  eventId              String   @unique
  jobId                String
  /// Null once the account is deleted (events are kept, anonymised).
  userId               String?
  printerId            String
  /// manual_size | template | excel_bulk | pdf | photo | scan | serial | other
  source               String
  labelWidthMm         Float
  labelHeightMm        Float
  templateId           String?
  templateNameSnapshot String?
  /// manual:{W}x{H} or template:{id}:{W}x{H}
  labelKey             String
  jobs                 Int      @default(1)
  /// Physical labels confirmed sent (headline number).
  labelsCount          Int
  ups                  Int      @default(1)
  appVersion           String?
  occurredAt           DateTime
  receivedAt           DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  printer Printer @relation(fields: [printerId], references: [id])

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([labelKey])
  @@index([printerId])
}

// ───────────────────────── Feedback and shop ─────────────────────────

model Feedback {
  id         String   @id @default(cuid())
  eventId    String   @unique
  userId     String
  /// 1 to 5
  rating     Int
  /// suggestion | bug | other
  category   String
  message    String?
  appVersion String?
  platform   String?
  /// new | reviewed | resolved
  status     String   @default("new")
  adminNote  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([status, createdAt])
}

/// "Can't find my template": a label the user asked us to add to the catalogue.
model TemplateRequest {
  id          String   @id @default(cuid())
  eventId     String   @unique
  userId      String
  /// What the label is for, in the user's words
  description String
  widthMm     Float?
  heightMm    Float?
  /// rectangle | rounded | circle | other
  shape       String?
  /// What the user had typed in Search Template
  searchText  String?
  appVersion  String?
  platform    String?
  /// new | in_progress | done | declined
  status      String   @default("new")
  adminNote   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ProductClick {
  id                  String   @id @default(cuid())
  eventId             String   @unique
  userId              String
  /// Stable product id from the app's bundled shop catalogue.
  productKey          String
  productNameSnapshot String
  /// labels | printers
  category            String
  source              String   @default("shop_buy")
  occurredAt          DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productKey, occurredAt])
}

// ───────────────────────── Clipart and template library ─────────────────────────

/// Label templates the admin uploads as SVG. Kept apart from clipart so each can grow its own way.
model TemplateCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  templates TemplateCategoryLink[]
}

model Template {
  id           String   @id @default(cuid())
  name         String
  /// The sanitised SVG code itself.
  svgCode      String
  widthMm      Float
  heightMm     Float
  viewBox      String?
  /// Sample content (list of text / barcode / qrcode / line elements in mm), null when none.
  sampleLayout Json?
  /// sha256 of the sanitised SVG.
  contentHash  String
  /// draft | published (only published reaches the app)
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// A template can sit in several categories, or none (then it shows only under All).
  categories TemplateCategoryLink[]

  @@index([status, updatedAt])
}

/// Which categories a template sits in. Deleting either side removes the link, never the other side.
model TemplateCategoryLink {
  itemId     String
  categoryId String
  createdAt  DateTime @default(now())

  item     Template         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId])
}

/// Clipart the admin adds on top of the clipart that ships inside the app.
model ClipartCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clipart ClipartCategoryLink[]
}

model Clipart {
  id          String   @id @default(cuid())
  name        String
  /// The sanitised SVG code itself.
  svgCode     String
  widthMm     Float?
  heightMm    Float?
  viewBox     String?
  contentHash String
  /// draft | published (only published reaches the app)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Clipart can sit in several categories, or none (then it shows only under All).
  categories ClipartCategoryLink[]

  @@index([status, updatedAt])
}

/// Which categories a clipart sits in. Deleting either side removes the link, never the other side.
model ClipartCategoryLink {
  itemId     String
  categoryId String
  createdAt  DateTime @default(now())

  item     Clipart         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category ClipartCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId])
}

// ───────────────────────── Platform ─────────────────────────

/// SMS one-time codes (hashed). Replaces the old in-memory store so it works across servers.
model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  /// register | login
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

/// Fixed-window counters (OTP sends, login attempts).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

/// Key/value settings the app reads from /api/app/config (admin contact, minimum build).
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
